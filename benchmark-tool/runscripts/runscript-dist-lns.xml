<runscript output="lns-output">

	<machine name="hpc" cpu="24x8xE5520@2.27GHz" memory="24GB"/>

  	<config name="dist-lns" template="templates/seq-lns.sh"/>

	<system name="mod_lns" version="conda" measures="lns" config="dist-lns">

    		<setting name="setting-1" cmdline="--max_steps=None --constrained" tag="basic" />

    </system>

	<distjob name="dist-lns" timeout="10" runs="2" script_mode="timeout" walltime="00:01:00" cpt="2" partition="all"/>

	<benchmark name="lns">
		<folder path="benchmarks/lns/"></folder>
	</benchmark>

	<project name="lns-dist-job" job="dist-lns">
		<runtag machine="hpc" benchmark="lns" tag="basic"/>
	</project>

</runscript>
