<runscript output="lns-output">

	<machine name="hpc" cpu="24x8xE5520@2.27GHz" memory="24GB"/>

  	<config name="seq-lns" template="templates/seq-lns.sh"/>

	<system name="mod_lns" version="conda" measures="lns" config="seq-lns">
    		<setting name="default_setting" cmdline="default --constrained" tag="basic"/>
			<setting name="heulingo_setting" cmdline="heulingo --heulingo-configuration=sgp" tag="basic">
				<encoding file="./configs/sgp/random_N.lp"/>
			</setting>
	</system>

	<distjob name="dist-lns" timeout="1800" runs="2" script_mode="timeout" walltime="1h" cpt="2"/>

	<benchmark name="lns">
		<folder path="benchmarks/sgp"/>
	</benchmark>

	<project name="lns-dist-job" job="dist-lns">
		<runtag machine="hpc" benchmark="lns" tag="basic"/>
	</project>

</runscript>
